# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KCMPICKS

# Sports API (The Odds API) - optional, currently unused (no key)
NEXT_PUBLIC_ODDS_API_KEY=your_odds_api_key

# OddsPapi (primary odds source - incl. Pinnacle, 250 req/month FREE)
# Get a key at: https://oddspapi.com/
NEXT_PUBLIC_ODDSPAPI_KEY=your_oddspapi_key

# OpenRouter (Jev AI - TypeSafe System One) - SERVER-ONLY, never use NEXT_PUBLIC_
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Auth Providers (configured in Supabase Dashboard)
# Google OAuth - Set up in Supabase Authentication > Providers
