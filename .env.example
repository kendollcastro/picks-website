# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SERVER-ONLY (never NEXT_PUBLIC_): used for team_ratings lookups + admin writes
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KCMPICKS

# Sports API (The Odds API) - SERVER-ONLY, never use NEXT_PUBLIC_ (would expose
# the key to the browser and let anyone burn your credits). The app fetches
# odds through the /api/odds proxy which caches per sport.
# Get a key at: https://the-odds-api.com/  (free: 500 credits/month)
ODDS_API_KEY=your_odds_api_key

# OddsPapi (primary odds source - incl. Pinnacle, 250 req/month FREE)
# SERVER-ONLY, never use NEXT_PUBLIC_ (would expose the key to the browser
# and let anyone burn your credits). The app fetches OddsPapi through the
# /api/oddspapi proxy which keeps the key server-side.
# Get a key at: https://oddspapi.com/
ODDS_PAPI_KEY=your_oddspapi_key

# OpenRouter (Jev AI - TypeSafe System One) - SERVER-ONLY, never use NEXT_PUBLIC_
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional OpenRouter tuning for the /api/ai/top-picks pipeline:
# research layer chat model (default: anthropic/claude-sonnet-5, ~$0.005/game)
OPENROUTER_RESEARCH_MODEL=anthropic/claude-sonnet-5
# Jev-probability blend toward the vig-removed market prior, 0..1 (default 0.4).
# Jev saturates probabilities toward 0/1 on lopsided team-quality gaps; 1 = raw
# Jev (unblended), lower = probabilities hew closer to the market.
JEV_MARKET_SHRINK=0.4

# Auth Providers (configured in Supabase Dashboard)
# Google OAuth - Set up in Supabase Authentication > Providers
